# ==============================================================================
# SECTION 43: SECURE HARDWARE ENCLAVE INTEL SGX APPLIANCE BLUEPRINT
# ==============================================================================
FROM ubuntu:24.04 AS sgx_env_builder

WORKDIR /opt/intel

# Provision core compilation runtimes and native SGX architectural libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libprotobuf-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Pull down the official Intel SGX driver platform allocations
# Note: For production air-gapped deployments, these components are cached locally
RUN git clone https://github.com \
    && cd linux-sgx-driver \
    && echo "[*] Hardening local enclave kernel driver layers..."

# Final runtime execution context stage
FROM python:3.11-slim-bookworm AS enclave_runner

WORKDIR /app

# Install runtime SGX architectural dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgmp-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Establish secure isolated enclave memory limits (e.g. 1024MB PRM Enclave Heap Allocation)
ENV INTEL_SGX_PRM_SIZE=1024
ENV PATH="/home/enclave_worker/.local/bin:$PATH"

# Create low-privileged isolation user context
RUN useradd -u 30001 -m enclave_worker
USER enclave_worker

# Extract compiled configuration properties cleanly into the workspace footprint
COPY --chown=enclave_worker:enclave_worker requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

COPY --chown=enclave_worker:enclave_worker yolo_master_core.py .
COPY --chown=enclave_worker:enclave_worker config_manager.py .

EXPOSE 8000

# Enforce secure memory tracking and initialize the core FastAPI backend inside the enclave boundaries
ENTRYPOINT ["python", "yolo_master_core.py"]

{
  "$schema": "https://json-schema.org",
  "title": "YoloJsonRpcInterfaceSchema",
  "description": "Defines the exact transactional layout required for third-party autonomous client ingestion integrations.",
  "type": "object",
  "required": ["jsonrpc", "method", "params", "id"],
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "type": "string",
      "enum": ["2.0"],
      "description": "Enforces conformity against standard JSON-RPC 2.0 interface protocols."
    },
    "method": {
      "type": "string",
      "enum": ["v2.agent.transact-kinetic", "v2.telemetry.query-metrics"],
      "description": "Target endpoint routing method for inbound node traffic."
    },
    "id": {
      "type": "integer",
      "description": "Unique request identifier tracker generated by the client broker."
    },
    "params": {
      "type": "object",
      "required": ["tenant_auth_context", "kinetic_envelope"],
      "additionalProperties": false,
      "properties": {
        "tenant_auth_context": {
          "type": "object",
          "required": ["x_tenant_id", "pqc_routing_signature"],
          "properties": {
            "x_tenant_id": {
              "type": "string",
              "description": "Canonical partition identification code string."
            },
            "pqc_routing_signature": {
              "type": "string",
              "description": "Lattice-ready verification token signature."
            }
          }
        },
        "kinetic_envelope": {
          "type": "object",
          "required": ["telemetry_sequence", "timestamp_ns", "kinetic_token", "raw_payload_data"],
          "properties": {
            "telemetry_sequence": {
              "type": "integer",
              "minimum": 0,
              "description": "Monotonically increasing block sequence tracker."
            },
            "timestamp_ns": {
              "type": "integer",
              "description": "Precise nanosecond hardware execution clock timestamp."
            },
            "kinetic_token": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{128}$",
              "description": "512-bit dynamic fluid key space transformation hash verification string."
            },
            "raw_payload_data": {
              "type": "object",
              "description": "Arbitrary client-side metrics or decision properties tracking machine choices."
            }
          }
        }
      }
    }
  }
}

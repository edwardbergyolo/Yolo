# SECTION 1: HARDENED ANTI-AMPLIFICATION EDGE SANITIZER
# ==============================================================================
class YoloStructuralSanitizerMiddleware(BaseHTTPMiddleware):
    """Enforces absolute payload boundaries at the HTTP wire layer to block fuzzing."""
    def __init__(self, app, max_payload_bytes: int = 2097152, max_bracket_depth: int = 5):
        super().__init__(app)
        self.max_payload_bytes = max_payload_bytes
        self.max_bracket_depth = max_bracket_depth

    async def dispatch(self, request: Request, call_next):
        if request.url.path == "/v2/agent/transact-kinetic":
            content_length = request.headers.get("content-length")
            if content_length and int(content_length) > self.max_payload_bytes:
                raise HTTPException(status_code=status.HTTP_413_REQUEST_ENTITY_TOO_LARGE, detail="Payload ceiling breached.")

            content_type = request.headers.get("content-type", "")
            if "multipart/form-data" in content_type:
                form_data = await request.form()
                for key in form_data.keys():
                    if key.count("[") > self.max_bracket_depth or key.count("]") > self.max_bracket_depth:
                        raise HTTPException(status_code=status.HTTP_422_UNPROCESSABLE_ENTITY, detail="Structural anomaly dropped.")

        return await call_next(request)


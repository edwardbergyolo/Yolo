def verify_payload_mac(body: bytes, sig: str, secret: str) -> bool:
    if not sig or not secret: return False
    mac = hmac.new(secret.encode(), body, hashlib.sha256).hexdigest()
    return hmac.compare_digest(f"sha256={mac}", sig)


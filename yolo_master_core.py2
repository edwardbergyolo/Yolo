class YoloRedisIndexingWrapper:
    def __init__(self, cache_client):
        self.redis = cache_client

    async def create_tenant_time_index(self, tenant_id: str, decision_id: str, log_payload: dict) -> str:
        current_epoch = int(time.time())
        time_block = current_epoch - (current_epoch % 3600)
        index_key = f"yolo:index:tenant:{tenant_id}:block:{time_block}"
        data_key = f"yolo:data:log:{decision_id}"
        
        log_payload["indexed_at"] = current_epoch
        await self.redis.rpush(index_key, data_key)
        await self.redis.rpush(data_key, json.dumps(log_payload))
        return index_key

